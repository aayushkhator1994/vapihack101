# Laptop Closed — paste your keys after each = (no quotes, no spaces)
 
# Vapi — dashboard.vapi.ai > API Keys (use the PRIVATE key)
VAPI_API_KEY=
# Vapi > Phone Numbers > click your number > copy its ID
VAPI_PHONE_NUMBER_ID=
# Leave blank — Opus fills this in after creating the assistant
VAPI_ASSISTANT_ID=
 
# Your own mobile, with country code, e.g. +14155551234
MY_PHONE_NUMBER=
 
# Deepgram — console.deepgram.com > API Keys
DEEPGRAM_API_KEY=
 
# Exa — dashboard.exa.ai > API Keys
EXA_API_KEY=
 
# Manus — manus.im > Settings > Integrations > API
MANUS_API_KEY=
 
# TypeSafe (Jev) — typesafe.ai dashboard
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=
 
# Leave blank — paste the https URL after you run: ngrok http 8000
PUBLIC_URL=
 
# Folder of the git repo the agent should summarize when the lid closes
REPO_PATH=
PORT=

# Twilio — console.twilio.com > Account Info (on the home page)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Vapi PUBLIC key — dashboard.vapi.ai > API Keys > Public (for the browser call on /talk)
VAPI_PUBLIC_KEY=

# ntfy push — subscribe to this topic in the ntfy phone app
NTFY_TOPIC=
# push | call | both
NOTIFY_MODE=push
